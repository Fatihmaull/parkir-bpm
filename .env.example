# ══════════════════════════════════════════════════════════════════
#  Template konfigurasi — SALIN ke .env, JANGAN commit .env
#  PRD §14: nol kredensial hardcoded (NFR-3)
# ══════════════════════════════════════════════════════════════════

# ── Identitas Node (untuk rantai audit per-node, PRD §9.1) ──
NODE_ID=edge-site-mall_jabar-01
TENANT_CODE=jabar_creative
SITE_CODE=mall_jabar

# ── edge-db ──
# EDGE_STORE=memory (bawaan) jalan tanpa DB sama sekali — demo/simulator (D12), tak butuh
# variabel di bawah ini. EDGE_STORE=postgres mengaktifkan repository pgx (task 5.1); Postgres-
# nya boleh dari mana saja yang bisa dijangkau: lokal (apt/Docker), atau cloud dev (mis. Neon)
# -- tak ada bedanya bagi edge-api selain isi EDGE_DATABASE_URL & sslmode.
EDGE_STORE=memory                  # memory|postgres
POSTGRES_USER=parkir
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=parkir_edge
# Lokal (apt/Docker): sslmode=disable. Cloud (Neon dkk.): sslmode=require, dan pakai
# connection string DIRECT (bukan varian -pooler) khusus untuk goose migrate/grants — pooler
# transaksi-mode kadang bermasalah untuk DDL. Runtime edge-api sendiri aman pakai pooler.
EDGE_DATABASE_URL=postgres://parkir:change_me_local@localhost:5432/parkir_edge?sslmode=disable

# ── edge-api ──
EDGE_API_PORT=8080
EDGE_LOG_LEVEL=info                # debug|info|warn|error
EDGE_ENV=development               # development|production

# ── cloud-db (Managed PostgreSQL) ──
CLOUD_DATABASE_URL=postgres://parkir:change_me_cloud@localhost:5433/parkir_cloud?sslmode=disable

# ── cloud-api ──
CLOUD_API_PORT=9090
CLOUD_LOG_LEVEL=info

# ── Auth (PRD §14) ──
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h               # 7 hari

# ── Edge ↔ Cloud sync (mTLS, FR-1.4) ──
SYNC_CLOUD_ENDPOINT=https://cloud.example.com
SYNC_TICK_SECONDS=10
SYNC_BATCH_SIZE=200
SYNC_CLIENT_CERT=./certs/edge-client.crt
SYNC_CLIENT_KEY=./certs/edge-client.key

# ── LPR service (gRPC) ──
LPR_GRPC_ADDR=localhost:50051
LPR_DEADLINE_MS=1000               # NFR-1.1
LPR_ENGINE_VERSION=yolov8n-easyocr-0.1

# ── Gate controller A6/A9-TCP (PRD v3 §5.1) — transport: tcp|sim ──
# Controller = TCP server per gerbang, Edge = client. Port default 56001; tiap controller
# punya IP sendiri di LAN lahan. RS232/COM sudah tidak dipakai (kontrak v1.0 dibatalkan).
# Driver tcpctl sudah ada sebagian (task 1.1–1.5) tetapi BELUM tersambung ke gatesvc
# (Layer-2 task 1.7) — biarkan `sim` sampai EPIK 1 selesai.
GATE_IN_TRANSPORT=sim
GATE_IN_ENDPOINT=192.168.1.11:56001
GATE_OUT_TRANSPORT=sim
GATE_OUT_ENDPOINT=192.168.1.12:56001
# GATE_*_ADDR: sisa kontrak v1.0 (byte ADDR frame STX/CRC). A6/A9 tanpa address; belum dibaca kode.
GATE_IN_ADDR=1
GATE_OUT_ADDR=2
EDC_TRANSPORT=sim
EDC_ENDPOINT=127.0.0.1:5001

# ── Payment Gateway (KREDENSIAL HANYA DI CLOUD — PRD §6.3 / D7) ──
PG_PROVIDER=midtrans               # midtrans|xendit
PG_SERVER_KEY=change_me_cloud_only
PG_WEBHOOK_SIGNATURE_SECRET=change_me_cloud_only

# ── Object storage (Spaces / S3) — snapshot LPR (PRD §4.4) ──
S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
S3_BUCKET=parkir-snapshots
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
IMAGE_LOCAL_RETENTION_DAYS=7
