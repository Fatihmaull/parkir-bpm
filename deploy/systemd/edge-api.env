# Konfigurasi edge-api — contoh untuk /etc/parkir/edge-api.env
#
# SUNTING sebelum dipakai. Berkas ini memuat rahasia, jadi:
#   sudo chmod 600 /etc/parkir/edge-api.env
#   sudo chown root:root /etc/parkir/edge-api.env
#
# NFR-3: nol kredensial hardcoded — semuanya lewat berkas ini.
# JANGAN commit berkas terisi ke repo; yang di repo hanya contoh ini.

# ── Identitas node ──
NODE_ID=edge-lahan-01
TENANT_CODE=tenant-demo
SITE_CODE=lahan-01

EDGE_ENV=production
EDGE_LOG_LEVEL=info
EDGE_API_PORT=8080

# ── Penyimpanan ──
# memory = in-memory (D12, mode demo). postgres BELUM terimplementasi di edge-api —
# lapisan pgx adalah task 5.1, jadi mengisinya "postgres" hari ini tidak menambah
# persistensi apa pun. Lihat docs/CATATAN_KEPUTUSAN.md §9.
EDGE_STORE=memory
# EDGE_DATABASE_URL=postgres://parkir:GANTI@127.0.0.1:5432/parkir?sslmode=disable

# ── Gerbang ──
# transport: sim | tcp. Untuk controller A6/A9 nyata pakai tcp + endpoint "ip:port".
# Peta pin & mode palang per gerbang ada di gates.config (PRD v3 §5.6).
GATE_IN_TRANSPORT=tcp
GATE_IN_ENDPOINT=192.168.1.51:56001
GATE_OUT_TRANSPORT=tcp
GATE_OUT_ENDPOINT=192.168.1.52:56001

# ── LPR ──
# Kosong = Recognizer degradasi (verdict UNREAD). LPR tak pernah menggerbang keputusan
# gerbang (D2), jadi lahan tetap melayani penuh tanpa ini.
# LPR_GRPC_ADDR=127.0.0.1:50051
LPR_ENGINE_VERSION=degraded
LPR_DEADLINE_MS=1000

# ── Sync ke Cloud ──
# Kosong = mode offline penuh. Cloud adalah tujuan replikasi, BUKAN dependensi runtime
# (P1) — gerbang tetap jalan walau ini mati atau internet putus.
# SYNC_CLOUD_ENDPOINT=https://cloud.example.com/api/v1/sync/batch
SYNC_TICK_SECONDS=10
SYNC_BATCH_SIZE=100

# ── Auth ──
# WAJIB diganti. Minimal 32 karakter saat EDGE_ENV=production — startup ditolak bila
# lebih pendek.
JWT_ACCESS_SECRET=GANTI-DENGAN-RAHASIA-ACAK-MINIMAL-32-KARAKTER
JWT_ACCESS_TTL=15m
